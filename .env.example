# Database (PostgreSQL 16 with PostGIS 3.4)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=realestate_feasibility
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realestate_feasibility

# Redis (Caching & Job Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO S3 Compatible)
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=feasibility-reports

# API Gateway Service
API_PORT=5001
API_HOST=0.0.0.0
JWT_SECRET=feasibility-dev-jwt-secret-key-32-chars-minimum!
JWT_EXPIRY_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5001/api/v1
VITE_MAP_DEFAULT_LAT=19.0760
VITE_MAP_DEFAULT_LNG=72.8777
VITE_MAP_DEFAULT_ZOOM=14
