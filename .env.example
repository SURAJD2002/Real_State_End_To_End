# ==============================================================================
# Planwise Enterprise — Environment Variables Configuration Template
# ==============================================================================
# NOTE: Use placeholders ONLY. Never commit real credentials, service-role keys,
# access tokens, or database passwords to version control.

# Database (PostgreSQL 16 with PostGIS 3.3+)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=realestate_feasibility
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/realestate_feasibility

# Supabase Managed Cloud Configuration (Optional/Production)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Redis (Caching & Job Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO S3 Compatible)
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=your_s3_access_key_placeholder
S3_SECRET_KEY=your_s3_secret_key_placeholder
S3_BUCKET=feasibility-reports

# API Gateway Service
API_PORT=5001
API_HOST=0.0.0.0
JWT_SECRET=your_jwt_secret_minimum_32_characters_placeholder
JWT_EXPIRY_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5001/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-placeholder
VITE_MAP_DEFAULT_LAT=19.0760
VITE_MAP_DEFAULT_LNG=72.8777
VITE_MAP_DEFAULT_ZOOM=14
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_placeholder
