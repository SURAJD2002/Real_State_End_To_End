      "name": "Statutory Road Widening Line Deduction",
      "category": "ROAD_WIDENING",
      "priority": 1,
      "description": "Deducts half the delta between proposed development plan road width and existing width along the road frontage boundary.",
      "citation": "DCPR 2034 Regulation 14 & Municipal Corporation Act Section 297",
      "severity": "MANDATORY",
      "parameters": {
        "formula": "(proposedRoadWidthM - existingRoadWidthM) / 2.0 along frontage edges"
      }
    },
